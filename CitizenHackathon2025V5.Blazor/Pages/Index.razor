@page "/"
@using CitizenHackathon2025.Blazor.DTOs
@using CitizenHackathon2025V5.Blazor.Client.Pages.FloatingWindows
@using CitizenHackathon2025V5.Blazor.Client.Shared
@using CitizenHackathon2025V5.Blazor.Client.Services
@using Microsoft.JSInterop
@inherits CitizenHackathon2025V5.Blazor.Client.Pages.Shared.OutZenMapPageBase
@inject Blazored.Toast.Services.IToastService ToastService
@inject CrowdCriticalAlertClientService CriticalAlertService

<PageTitle>OutZen - Home</PageTitle>

<div class="home-page">
    @if (_welcomeAssistantOpen)
    {
        <div class="oz-assistant-welcome-layer"
             role="presentation">

            <section id="outzenWelcomeAssistant"
                     class="oz-assistant-welcome"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="oz-assistant-welcome-title">

                <button type="button"
                        class="oz-assistant-welcome-close"
                        title="Fermer"
                        aria-label="Fermer l'assistant"
                        @onclick="CloseWelcomeAssistantAsync">
                    ×
                </button>

                <div class="oz-assistant-welcome-header" data-oz-drag-handle="true" title="Maintenir et déplacer l'assistant">

                    <div class="oz-assistant-avatar"
                         aria-hidden="true">
                        🧠
                    </div>

                    <div>
                        <div class="oz-assistant-eyebrow">
                            OUTZEN ASSISTANT
                        </div>

                        <h2 id="oz-assistant-welcome-title">
                            Bonjour
                            <span class="oz-assistant-wave @(_welcomeAssistantStep == WelcomeAssistantIntroStep ? "is-waving" : null)"aria-hidden="true">
                            👋
                        </span>
                    </h2>
                    </div>

                </div>

                <div class="oz-assistant-conversation" aria-live="polite" aria-atomic="true">

                    <div class="oz-assistant-stage-host">

                        @if (_welcomeAssistantStep == WelcomeAssistantIntroStep)
                        {
                            <div @key="WelcomeAssistantIntroStep" class="oz-assistant-stage oz-assistant-stage--temporary">

                                <div class="oz-assistant-message">
                                    Bonjour, je suis votre assistant OutZen.
                                    Je suis là pour vous donner des suggestions
                                    touristiques et agrémenter votre journée.
                                </div>

                            </div>
                        }
                        else if (_welcomeAssistantStep == WelcomeAssistantInvitationStep)
                        {
                            <div @key="WelcomeAssistantInvitationStep"
                                 class="oz-assistant-stage oz-assistant-stage--temporary">

                                <div class="oz-assistant-message oz-assistant-message--secondary">
                                    Posez-moi les questions que vous voulez.
                                </div>

                            </div>
                        }
                        else
                        {
                            <div @key="WelcomeAssistantDestinationStep" class="oz-assistant-stage oz-assistant-stage--final">

                                <div class="oz-assistant-question"> 
                                    Où avez-vous l'intention d'aller aujourd'hui ?
                                </div>

                                <form @onsubmit="SubmitWelcomeDestinationAsync" @onsubmit:preventDefault="true">

                                    <div class="oz-assistant-destination">

                                        <input type="text"
                                               class="oz-assistant-destination-input"
                                               placeholder="Ex. Dinant, Namur, Bruxelles..."
                                               autocomplete="off"
                                               autofocus
                                               @bind="_welcomeDestination"
                                               @bind:event="oninput" />

                                        <button type="submit"
                                                class="oz-assistant-submit"
                                                disabled="@(
                                                _isSendingPrompt || string.IsNullOrWhiteSpace(_welcomeDestination))">

                                    @if (_isSendingPrompt)
                                            {
                                                <span>Préparation…</span>
                                            }
                                            else
                                            {
                                                <span>
                                                    Découvrir avec OutZen
                                                </span>

                                                <span aria-hidden="true">
                                                    →
                                                </span>
                                            }

                                        </button>

                                    </div>

                                </form>

                                <button type="button" class="oz-assistant-later" @onclick="CloseWelcomeAssistantAsync">
                                    Pas maintenant
                                </button>

                            </div>
                        }

                    </div>

                </div>

            </section>

        </div>
    }

    <div class="critical-alert-panel alert-cluster">

        <div class="alert-cluster-header">OUTZEN CONTROL CENTER</div>

        <div class="alert-cluster-grid">
            <button type="button"
                    class="outzen-alert-button outzen-alert-button--crowd alert-main"
                    disabled="@_criticalAlertSending"
                    @onclick="SendCriticalCrowdAlertAsync">
                <span class="outzen-alert-label">FULL<br />ALERT</span>
            </button>

            <button class="outzen-alert-button outzen-alert-button--weather alert-secondary"
                    type="button"
                    @onclick="SendCriticalWeatherAlertAsync"
                    disabled="@_criticalWeatherAlertSending">
                <span class="outzen-alert-label">CRITICAL<br />WEATHER</span>
            </button>

            <button class="outzen-alert-button outzen-alert-button--traffic alert-secondary"
                    type="button"
                    @onclick="SendCriticalTrafficAlertAsync"
                    disabled="@_criticalTrafficSending">
                <span class="outzen-alert-label outzen-alert-label--traffic">
                    CRITICAL<br />TRAFFIC<br />CONGESTION
                </span>
            </button>

            <button class="outzen-alert-button outzen-alert-button--disaster alert-secondary"
                    type="button"
                    @onclick="SendCriticalDisasterAlertAsync"
                    disabled="@_criticalDisasterSending">
                <span class="outzen-alert-label outzen-alert-label--disaster">
                    DISASTER<br />ALERT
                </span>
            </button>
        </div>

        <div class="alert-cluster-hint">DOUBLE-CLICK TO DEPLOY</div>

        <div class="critical-alert-infos">
            @if (!string.IsNullOrWhiteSpace(_criticalAlertStatus))
            {
                <div class="critical-alert-status">@_criticalAlertStatus</div>
            }

            @if (!string.IsNullOrWhiteSpace(_criticalWeatherAlertStatus))
            {
                <div class="critical-alert-status critical-alert-status--weather">
                    @_criticalWeatherAlertStatus
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_criticalTrafficStatus))
            {
                <div class="critical-alert-status critical-alert-status--traffic">
                    @_criticalTrafficStatus
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_criticalDisasterStatus))
            {
                <div class="critical-alert-status critical-alert-status--disaster">
                    @_criticalDisasterStatus
                </div>
            }

            <div class="critical-alert-place">
                Place: @_selectedPlaceName
            </div>
        </div>
    </div>
    @* <div id="@MapId" style="height: 72vh;"></div> *@
    <!-- Summary map -->
    <div class="oz-page oz-page--home">
        <div class="homeMapCard oz-home-map-shell">
            @* Existing OutZen Home map.
           Do NOT create another leafletMap-home element. *@
            <div id="@MapId"
                 class="oz-map">
            </div>

            @if (_homeEmergencyNotices.Count > 0)
            {
                <div class="oz-home-emergency-notice-stack" aria-live="polite">
                    @foreach (var notice in _homeEmergencyNotices)
                    {
                        <article @key="notice.Key"
                                 class="oz-home-emergency-notice @(notice.Critical ? "is-critical" : "is-advisory")"
                                 style="@($"--oz-notice-duration:{notice.DurationSeconds}s;")"
                                 role="@(notice.Critical ? "alert" : "status")">
                            <div class="oz-home-emergency-notice-icon">
                                @(notice.Critical ? "🚨" : "📢")
                            </div>
                            <div class="oz-home-emergency-notice-content">
                                <div class="oz-home-emergency-notice-source">

                                    @notice.SourceCode·@(notice.SourceCode.Contains("SIM", StringComparison.OrdinalIgnoreCase) ? "SIMULATION" : "OFFICIAL")

                                </div>
                                <strong>
                                    @notice.Title
                                </strong>
                                @if (!string.IsNullOrWhiteSpace(notice.Message))
                                {
                                    <p>
                                        @notice.Message
                                    </p>
                                }
                                @if (!string.IsNullOrWhiteSpace(notice.Instructions))
                                {
                                    <p class="oz-home-emergency-instruction">
                                        @notice.Instructions
                                    </p>
                                }
                            </div>
                            <button type="button"
                                    class="oz-home-emergency-notice-close"
                                    title="Fermer"
                                    aria-label="Fermer le message"
                                    @onclick="@(() => DismissHomeEmergencyNotice(notice.Key))">
                                ×
                            </button>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
    <OzFloatingWindow Id="msgDrawer"
                      @bind-IsOpen="_msgDrawerOpen"
                      Class="oz-glass oz-drawer--fill"
                      Title="Comments"
                      Subtitle="Live"
                      FabIcon="💬 Comments"
                      FabTitle="Open Messages"
                      FabRight="18px"
                      FabBottom="84px"
                      StartLeft="24px"
                      StartTop="420px"
                      Width="420px"
                      MinWidth="320px"
                      MaxWidth="900px">
        <MessageFloatingContent PlaceId="@_selectedPlaceId" PlaceName="@_selectedPlaceName" />
    </OzFloatingWindow>

    <OzFloatingWindow Id="gptDrawer"
                      @bind-IsOpen="_gptDrawerOpen"
                      Class="oz-glass oz-drawer--fill oz-drawer--gpt"
                      Title="OutZen GPT"
                      Subtitle="Suggestions"
                      FabIcon="🧠 IA Suggestions"
                      FabTitle="Open GPT"
                      FabRight="18px"
                      FabBottom="18px"
                      StartLeft="24px"
                      StartTop="120px"
                      Width="420px"
                      MinWidth="320px"
                      MaxWidth="960px">

        <div class="gpt-drawer-content">
            <input class="oz-input"
                   placeholder="Filter GPT history..."
                   @bind="_q"
                   @bind:event="oninput" />

            <div class="oz-prompt-compose">
                <textarea class="oz-input"
                          rows="3"
                          placeholder="Write your prompt..."
                          @bind="_userPrompt"></textarea>

                <div class="oz-compose-actions">
                    <button type="button"
                            class="oz-btn"
                            @onclick="SendUserPromptAsync"
                            disabled="@(_isSendingPrompt || string.IsNullOrWhiteSpace(_userPrompt))">
                        @(_isSendingPrompt ? "Sending..." : "Send to AI")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_gptStatusMessage))
                    {
                        <div class="gpt-status"
                             role="status"
                             aria-live="polite">
                            @_gptStatusMessage
                        </div>
                    }
                </div>
            </div>

            @{
                var filtered = FilterGpt(_visible).ToList();
                var latest = filtered.FirstOrDefault();
                var history = filtered.Skip(1).ToList();
            }

            @if (latest is not null)
            {
                <div class="gpt-latest-shell">
                    <div class="gpt-latest-header">
                        <span class="gpt-latest-title">Last reply</span>
                        <span class="gpt-latest-date">@latest.CreatedAt.ToLocalTime().ToString("g")</span>
                    </div>

                    <article class="gpt-card gpt-card--latest">
                        <div class="gpt-card-top">
                            <div class="gpt-meta">
                                <span class="gpt-id">#@latest.Id</span>
                                <span class="gpt-date">@latest.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>

                            <div class="oz-actions">
                                <button type="button" class="oz-mini" @onclick="@(() => Replay(latest.Id))">Replay</button>
                                <button type="button" class="oz-mini" @onclick="@(() => Copy(latest.Prompt))">Copy prompt</button>
                                <button type="button" class="oz-mini" @onclick="@(() => Copy(latest.Response))">Copy response</button>
                            </div>
                        </div>

                        <div class="gpt-block">
                            <div class="gpt-block-label">Prompt</div>
                            <pre class="gpt-pre gpt-pre--prompt">@(string.IsNullOrWhiteSpace(latest.Prompt) ? "— Prompt empty —" : latest.Prompt)</pre>
                        </div>

                        <div class="gpt-block">

                            <div class="gpt-block-label">
                                Response
                            </div>

                            <div class="gpt-rich-response gpt-pre gpt-pre--response" aria-live="polite">

                                @if (_isSendingPrompt || string.IsNullOrWhiteSpace(latest.Response) || string.Equals(latest.Response?.Trim(), GptPendingResponse, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="gpt-response-pending" role="status">

                                        <span class="gpt-response-pending-brain" aria-hidden="true">
                                            🧠
                                        </span>

                                        <span>
                                            OutZen is preparing its suggestions…
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    @FormatGptResponse(latest.Response)
                                }

                            </div>

                        </div>
                    </article>
                </div>

                <div class="gpt-history-shell @(_historyCollapsed ? "is-collapsed" : null)">
                    <div class="gpt-history-header">
                        <span class="gpt-history-title">History</span>

                        <div class="oz-actions">
                            <span class="gpt-history-count">@history.Count element(s)</span>
                            <button type="button"
                                    class="gpt-history-toggle"
                                    @onclick="ToggleHistory">
                                @(_historyCollapsed ? "Show" : "Hide")
                            </button>
                        </div>
                    </div>

                    <div class="oz-scrollfill oz-scrollfill--gpt-history">
                        @if (history.Count == 0)
                        {
                            <div class="oz-empty">No additional history.</div>
                        }
                        else
                        {
                            <div class="oz-list oz-list--gpt">
                                @foreach (var x in history)
                                {
                                    <article class="gpt-card gpt-card--compact">
                                        <div class="gpt-card-top">
                                            <div class="gpt-meta">
                                                <span class="gpt-id">#@x.Id</span>
                                                <span class="gpt-date">@x.CreatedAt.ToLocalTime().ToString("g")</span>
                                            </div>

                                            <div class="oz-actions">
                                                <button type="button" class="oz-mini" @onclick="@(() => Replay(x.Id))">Replay</button>
                                                <button type="button" class="oz-mini" @onclick="@(() => Copy(x.Prompt))">Copy prompt</button>
                                                <button type="button" class="oz-mini" @onclick="@(() => Copy(x.Response))">Copy response</button>
                                            </div>
                                        </div>

                                        <div class="gpt-block">
                                            <div class="gpt-block-label">Prompt</div>
                                            <pre class="gpt-pre gpt-pre--prompt">@(string.IsNullOrWhiteSpace(x.Prompt) ? "— Empty prompt —" : x.Prompt)</pre>
                                        </div>

                                        <div class="gpt-block">
                                            <div class="gpt-block-label">Response</div>
                                            <div class="gpt-rich-response gpt-pre gpt-pre--response">
                                                @FormatGptResponse(x.Response)
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="oz-empty">No AI interactions yet.</div>
            }
        </div>
    </OzFloatingWindow>

    <!-- ==========================================================
     HOME INTRO PANEL
     ========================================================== -->
    <section class="home-intro-panel oz-home-glass-panel scroll-fade">

        <div class="home-header">
            <div class="home-header-left">

                <h1 class="index-title">
                    Welcome to OutZen application
                </h1>

                <p class="index-subtitle">
                    Explore events with peace of mind,
                    even when the crowds get involved.
                </p>

            </div>
        </div>

        <div class="home-intro-actions">
            <button class="index-cta"
                    @onclick="ScrollToSuggestions">
                Discover the suggestions
            </button>
        </div>

    </section>

    <!-- Main block: map + side panel -->
    <div class="home-main">
        <!-- Side panel: GPT + message -->
        <aside class="home-side-panel scroll-fade">
            <section class="home-block">
                <h2>Your message</h2>
                <EditForm Model="@Model" OnValidSubmit="SendMessageAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <input class="input"
                           placeholder="Message…"
                           @bind="NewMessage"
                           @bind:event="oninput" />

                    <button class="btn"
                            disabled="@IsSending"
                            @onclick="SendMessageAsync">
                        Send
                    </button>
                </EditForm>
            </section>
        </aside>
    </div>
    <!-- Suggestions (for the scroll button) -->
    <div>
        <section class="index-section oz-home-glass-panel scroll-fade" id="suggestions">
            <h2>Suggestions Zen</h2>
            <p>
                Here are some alternatives within a 25 km radius of the selected event:
            </p>

            <ul>
                <li>Upper Sambre Natural Park</li>
                <li>Outdoor yoga classes in Gosselies</li>
                <li>Open-air theater – La Traviata</li>
                <li>Bois-du-Casier site in Marcinelle</li>
                <li>Leisure center right next door</li>
                <li>Mettet Circuit and its driving school</li>
                <li>Maredsous Abbey: the third most important tourist and gastronomic destination</li>
                <li>The Lacs de l'Eau-d'Heure dams For those who love water sports and swimming</li>
                <li>The old arm of the Sambre in the Landelies valley For those who enjoy a peaceful change of scenery.</li>
                <li>The white boundary stone at Loverval. For those who love places steeped in history.</li>
                <li>The former Monceau-sur-Sambre power plant. A prime location for urban exploration in Belgium</li>
            </ul>
        </section>
    </div>
    <div class="earth-container scroll-fade">
        <Globe CanvasId="homeEarth" Width="320" Height="320" ShowControls="true" CssClass="globe-in-header" />
    </div>
    <div>
        <button class="btn" @onclick="EnableSoundAsync">Enable sound</button>
    </div>

    <footer class="index-footer">
        &copy; 2025 OutZen – Zen in the crowd, Zen in life.
    </footer>
</div>






































































































































