@* NavMenu.razor *@
<nav class="main-nav"
     @ref="_navRef"
     aria-label="Navigation principale">

    <button type="button"
            class="oz-nav-toggle"
            aria-label="Ouvrir ou fermer le menu"
            aria-expanded="@isMenuOpen"
            @onclick="ToggleNavMenu">

        <span aria-hidden="true">
            ☰
        </span>

    </button>


    <div class="nav-drawer">

        <div class="oz-nav-groups">

            @foreach (var group in MenuGroups)
            {
                <section class="oz-nav-group @group.CssClass"
                         aria-labelledby="@($"nav-group-{group.Key}")">

                    <div class="oz-nav-group-header">

                        <span class="oz-nav-group-line"></span>

                        <span id="@($"nav-group-{group.Key}")"
                              class="oz-nav-group-title">
                            @group.Title
                        </span>

                        <span class="oz-nav-group-line"></span>

                    </div>


                    <div class="oz-nav-group-items">

                        @foreach (var item in group.Items)
                        {
                            <NavLink href="@item.Href" Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="oz-nav-link" aria-label="@item.Text" @onclick="CloseMenu">

                                <span class="oz-nav-link-icon" aria-hidden="true">
                                    @item.Icon
                                </span>

                        @if (!item.IconOnly)
                                {
                                    <span class="oz-nav-link-text">
                                        @item.Text
                                    </span>
                                }

                            </NavLink>
                        }

                    </div>

                </section>
            }

        </div>

    </div>

</nav>
































































































